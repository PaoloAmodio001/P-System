from dataclasses import dataclass

from core.global_proof import GlobalStateProof


@dataclass(frozen=True)
class Decision:
    accepted: bool
    reason: str


def distinguish(
    candidate_a: GlobalStateProof,
    candidate_b: GlobalStateProof,
) -> Decision:
    """
    Primo modello di decisione.

    IMPORTANTE:
    Questo non implementa ancora un consenso reale.
    Verifica soltanto se le prove forniscono una
    proprietà intrinseca sufficiente per distinguere
    due candidati.

    Se entrambi sono validi e non esiste altra
    informazione, il decisore non può scegliere
    arbitrariamente uno dei due.
    """

    if candidate_a.state_root == candidate_b.state_root:
        return Decision(
            accepted=True,
            reason="SAME_STATE",
        )

    if (
        candidate_a.verify
        and candidate_b.verify
    ):
        return Decision(
            accepted=False,
            reason="INSUFFICIENT_INFORMATION",
        )

    return Decision(
        accepted=False,
        reason="INVALID_CANDIDATE",
    )
